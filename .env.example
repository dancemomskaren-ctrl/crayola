# DeepSeek API Configuration (for script generation)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
# Model name. The legacy "deepseek-chat" and "deepseek-reasoner" aliases
# were retired 2026-07-24 and no longer resolve. Defaults to
# deepseek-v4-flash; use deepseek-v4-pro for the higher-quality tier.
# DEEPSEEK_MODEL=deepseek-v4-flash

# Whisper transcription model (runs locally, no API key needed).
# Defaults to medium.en for English — noticeably better than "base" on
# sermon audio. Use large-v3 for best accuracy, small.en/base for speed.
# WHISPER_MODEL=medium.en

# Transcription backend. Defaults to faster-whisper (CTranslate2 int8):
# same weights, roughly 4x faster on ~60% of the RAM, which is what makes
# the medium model usable on a laptop. Install it with:
#   pip install faster-whisper
# If it is not installed, transcription automatically falls back to the
# reference `whisper` CLI. Set to "openai" to force that fallback.
# WHISPER_BACKEND=openai

# Optional: OpenAI-compatible API for script generation
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com

# Platform Posting API Keys (optional — enables one-click posting)
# Instagram Graph API
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
# INSTAGRAM_ACCOUNT_ID=your_account_id_here

# TikTok API
# TIKTOK_ACCESS_TOKEN=your_tiktok_token_here

# YouTube Data API
# YOUTUBE_API_KEY=your_youtube_api_key_here
# YOUTUBE_CHANNEL_ID=your_channel_id_here
